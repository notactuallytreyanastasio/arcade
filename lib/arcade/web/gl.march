mod Arcade.Web.Gl do

  -- Arcade.Cel drawn with WebGL, backed by arcade_gl.mjs (march copies it
  -- beside the build). Each fn is one
  -- call into the glue; what is drawn, where and in what order is decided by
  -- the Arcade.Cel frame it is handed.
  needs IO.Foreign

  extern "./arcade_gl.mjs" : Cap(IO.Foreign) do
    fn gl_open(id : String) : Bool
    fn gl_mesh(id : Int, floats : List(Float)) : Unit
    fn gl_begin(w : Float, h : Float, dpr : Float, floats : List(Float)) : Unit
    fn gl_draw(id : Int, floats : List(Float)) : Unit
    fn gl_end() : Unit
  end

  doc """A WebGL context on the canvas with this id, and the cel program. False when there
  is no such canvas or the browser gives no context. With "keep" in the page's query
  string the drawing buffer is kept after a frame, and `globalThis.__arcadeGl` can
  read its pixels (for a playtest)."""
  fn open(id : String) : Bool do
    gl_open(id)
  end

  doc """Upload a mesh, replacing any other under its id."""
  fn upload(m : Arcade.Cel.CelMesh) : () do
    gl_mesh(m.id, m.floats)
  end

  fn draw(i : Arcade.Cel.CelItem) : () do
    gl_draw(i.mesh, Arcade.Cel.item_floats(i))
  end

  doc """Draw one frame on a canvas of w by h CSS pixels at dpr device pixels each."""
  fn frame(w : Float, h : Float, dpr : Float, f : Arcade.Cel.CelFrame) : () do
    gl_begin(w, h, dpr, Arcade.Cel.frame_floats(f))
    List.each(f.items, draw)
    gl_end()
  end

end
