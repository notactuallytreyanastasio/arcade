mod TumbleNames do

  -- The names tumble's two builds agree on: the AudioWorkletProcessor the
  -- worklet build registers and the main build asks for, and the globalThis
  -- name of the audio log a playtest reads.
  needs IO.Foreign

  fn processor() : String do
    "tumble-synth"
  end

  fn debug_global() : String do
    "__tumbleAudio"
  end

end
