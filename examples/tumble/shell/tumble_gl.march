mod TumbleGl do

  -- Tumble.Cel drawn with WebGL, backed by tumble_gl.mjs. Each fn is one
  -- call into the glue; what is drawn, where and in what order is decided by
  -- the Tumble.Cel frame it is handed.
  needs IO.Foreign

  extern "./tumble_gl.mjs" : Cap(IO.Foreign) do
    fn gl_open(id : String) : Bool
    fn gl_mesh(id : Int, floats : List(Float)) : Unit
    fn gl_begin(w : Float, h : Float, dpr : Float, floats : List(Float)) : Unit
    fn gl_draw(id : Int, floats : List(Float)) : Unit
    fn gl_end() : Unit
  end

  doc """A WebGL context on the canvas with this id. False when the browser gives none."""
  fn open(id : String) : Bool do
    gl_open(id)
  end

  doc """Upload a mesh, replacing any other under its id."""
  fn upload(m : CelMesh) : () do
    gl_mesh(m.id, m.floats)
  end

  fn draw(i : CelItem) : () do
    gl_draw(i.mesh, Tumble.Cel.item_floats(i))
  end

  doc """Draw one frame on a canvas of w by h CSS pixels at dpr device pixels each."""
  fn frame(w : Float, h : Float, dpr : Float, f : CelFrame) : () do
    gl_begin(w, h, dpr, Tumble.Cel.frame_floats(f))
    List.each(f.items, draw)
    gl_end()
  end

end
