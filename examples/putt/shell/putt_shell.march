mod PuttShell do

  -- Putt's browser shell, and the entry point of its browser build
  -- (dist/putt.mjs): the hooks Arcade.Web.Runtime runs one PuttModel with.
  -- The runtime owns the canvas, the frame loop and the events; this module
  -- says what they mean for putt:
  --
  --   boot      the launch seed to Putt.Rules.new_game, and the speakers
  --   pointer   a press, a drag away from the target and a release are a
  --             putt (Putt.Aim.shot_of_pull); while the pointer is down
  --             the frame shows what the putt would do. A release inside
  --             the dead zone is no putt. A tap on a finished hole tees up
  --             the next, and on a finished course starts a new game; a
  --             press and release on the new-game button starts one at any
  --             time
  --   tick      a struck putt is played back along its sampled path, at
  --             real time, sending Putt.Cues.audio_between each frame;
  --             the state moves on to the turn's `after` when it ends
  --   effects   audio commands to Arcade.Web.Audio
  --   marks     what the playtest reads off <html>
  --
  -- Every rule is in Putt.Rules, the pull's meaning in Putt.Aim and every
  -- word and shape of the frame in Putt.Hud; nothing here decides how the
  -- ball rolls or what the player reads.
  needs IO.Foreign

  -- A struck putt being shown: the state it was struck from (the hole and
  -- caption drawn meanwhile), the turn the rules returned, when the shell
  -- started it on the frame clock, and how far into it the last frame got
  -- (negative before the first, so what sounds at 0 is sent once).
  type PuttPlayback = {
    from_state : PuttState,
    turn : PuttTurn,
    began : Float,
    reached : Float
  }

  -- A pointer held down: where it pressed and where it is now, CSS pixels.
  -- Only a press made while no putt is rolling is kept, so a finger already
  -- down when the ball drops cannot tap the scorecard away.
  type PuttDrag = { pressed : Vec2, now : Vec2 }

  type PuttModel = {
    rs : PuttRules,
    aim : AimTuning,
    game : PuttState,
    view_w : Float,
    view_h : Float,
    drag : Option(PuttDrag),
    shown : Option(PuttPlayback),
    putts : Int
  }

  type PuttMsg =
    PmTick(Float)
    | PmResize(Float, Float)
    | PmDown(List(TrackPoint))
    | PmMove(List(TrackPoint))
    | PmUp(List(TrackPoint))
    | PmCancel
    | PmVisible(Bool)

  type PuttFx = PfAudio(List(AudioCmd(PuttCue)))

  -- The model as the runtime holds it: a record type is spelled out field by
  -- field in every generic specialization's name on JS, a one-constructor
  -- type by its name (see Arcade.Web.Runtime.WebHooks).
  type Held = HeldModel(PuttModel)

  fn unheld(b : Held) : PuttModel do
    match b do
    HeldModel(m) -> m
    end
  end

  fn held(r : (PuttModel, List(PuttFx))) : (Held, List(PuttFx)) do
    let (m, effects) = r
    (HeldModel(m), effects)
  end

  fn quiet(m : PuttModel) : (PuttModel, List(PuttFx)) do
    (m, [])
  end

  -- ---- Boot ----
  fn boot(w : Float, h : Float, seed : U64) : (Held, List(PuttFx)) do
    let rs = Putt.Rules.rules()
    PuttAudio.start()
    let m =
      {
        rs: rs,
        aim: Putt.Aim.tuning(),
        game: Putt.Rules.new_game(rs, seed),
        view_w: w,
        view_h: h,
        drag: None,
        shown: None,
        putts: 0
      }
    held(quiet(m))
  end

  -- ---- Update ----
  fn update(m : PuttModel, x : PuttMsg) : (PuttModel, List(PuttFx)) do
    match x do
    PmTick(t) -> tick(m, t)
    PmResize(w, h) -> quiet({ m with view_w: w, view_h: h })
    PmDown(ps) -> quiet(pressed(m, ps))
    PmMove(ps) -> quiet(moved(m, ps))
    PmUp(ps) -> lift(moved(m, ps), ps)
    PmCancel -> quiet({ m with drag: None })
    PmVisible(_) -> quiet(m)
    end
  end

  -- The newest of a batch of samples, as (time, place).
  fn newest(ps : List(TrackPoint)) : Option((Float, Vec2)) do
    match ps do
    Nil -> None
    Cons(p, Nil) -> Some((p.gt, Arcade.Vec2.vec2(p.gx, p.gy)))
    Cons(_, rest) -> newest(rest)
    end
  end

  fn pressed(m : PuttModel, ps : List(TrackPoint)) : PuttModel do
    match m.shown do
    Some(_) -> { m with drag: None }
    None -> do
      match newest(ps) do
      Some((_, at)) -> { m with drag: Some({ pressed: at, now: at }) }
      None -> { m with drag: None }
      end
    end
    end
  end

  fn moved(m : PuttModel, ps : List(TrackPoint)) : PuttModel do
    match m.drag do
    None -> m
    Some(d) -> do
      match newest(ps) do
      Some((_, at)) -> { m with drag: Some({ d with now: at }) }
      None -> m
      end
    end
    end
  end

  -- The pointer lifted, the drag already moved to where it did. A press and
  -- release both on the new-game button is a new game whatever the phase.
  fn lift(m0 : PuttModel, ps : List(TrackPoint)) : (PuttModel, List(PuttFx)) do
    let m = { m0 with drag: None }
    match m0.drag do
    None -> quiet(m)
    Some(d) -> do
      let button = Putt.Hud.new_game_box(Arcade.Camera.viewport(m.view_w, m.view_h))
      if Putt.Hud.in_box(button, d.pressed) && Putt.Hud.in_box(button, d.now) do
        again(m)
      else
        match m.game.phase do
        PuttAiming -> released(m, d, ps)
        PuttHoleDone -> next(m)
        PuttCourseDone -> again(m)
        end
      end
    end
    end
  end

  fn released(m : PuttModel, d : PuttDrag, ps : List(TrackPoint)) : (PuttModel, List(PuttFx)) do
    match (Putt.Aim.shot_of_pull(m.rs, m.aim, Arcade.Vec2.sub(d.now, d.pressed)), newest(ps)) do
    (Some(shot), Some((at, _))) -> strike(m, shot, at)
    (_, _) -> quiet(m)
    end
  end

  fn strike(m : PuttModel, shot : PuttShot, at : Float) : (PuttModel, List(PuttFx)) do
    match Putt.Rules.play(m.rs, PuttStrike(shot), m.game) do
    Err(_) -> quiet(m)
    Ok(turn) -> do
      let p = { from_state: m.game, turn: turn, began: at, reached: -1.0 }
      quiet({ m with shown: Some(p), putts: m.putts + 1 })
    end
    end
  end

  fn next(m : PuttModel) : (PuttModel, List(PuttFx)) do
    match Putt.Rules.play(m.rs, PuttNext, m.game) do
    Err(_) -> quiet(m)
    Ok(turn) -> ({ m with game: turn.after }, [PfAudio(Putt.Cues.audio(m.rs, turn.told))])
    end
  end

  -- A new game, seeded from the last one's generator.
  fn again(m : PuttModel) : (PuttModel, List(PuttFx)) do
    let (seed, _) = Arcade.Rng.next(m.game.rng)
    quiet({ m with game: Putt.Rules.new_game(m.rs, seed) })
  end

  -- ---- Playback ----
  fn tick(m : PuttModel, t : Float) : (PuttModel, List(PuttFx)) do
    match m.shown do
    None -> quiet(m)
    Some(p) -> play_to(m, p, t -. p.began)
    end
  end

  fn play_to(m : PuttModel, p : PuttPlayback, upto : Float) : (PuttModel, List(PuttFx)) do
    let sounds = PfAudio(Putt.Cues.audio_between(m.rs, p.turn.told, p.reached, upto))
    if upto >= path_end(p.turn.rolled) do
      ({ m with game: p.turn.after, shown: None }, [sounds])
    else
      ({ m with shown: Some({ p with reached: upto }) }, [sounds])
    end
  end

  fn path_end(path : List(Sampled(Vec2))) : Float do
    match path do
    Nil -> 0.0
    Cons(a, Nil) -> a.sampled_at
    Cons(_, rest) -> path_end(rest)
    end
  end

  -- Where the ball is `t` seconds into its path: between the two samples
  -- either side, in a straight line.
  fn ball_at(path : List(Sampled(Vec2)), t : Float, fallback : Vec2) : Vec2 do
    match path do
    Nil -> fallback
    Cons(a, rest) -> if t <= a.sampled_at do a.point else along(a, rest, t) end
    end
  end

  fn along(a : Sampled(Vec2), rest : List(Sampled(Vec2)), t : Float) : Vec2 do
    match rest do
    Nil -> a.point
    Cons(b, more) -> if t <= b.sampled_at do between(a, b, t) else along(b, more, t) end
    end
  end

  fn between(a : Sampled(Vec2), b : Sampled(Vec2), t : Float) : Vec2 do
    let span = b.sampled_at -. a.sampled_at
    if span > 0.0 do
      Arcade.Vec2.add(a.point, Arcade.Vec2.scale(Arcade.Vec2.sub(b.point, a.point), (t -. a.sampled_at) /. span))
    else
      b.point
    end
  end

  -- ---- The frame ----
  fn scene(m : PuttModel) : List(DrawOp) do
    let vp = Arcade.Camera.viewport(m.view_w, m.view_h)
    match m.shown do
    None -> Putt.Hud.frame(m.rs, m.aim, m.game, vp, m.game.ball, moment(m))
    Some(p) -> do
      let at = ball_at(p.turn.rolled, p.reached, p.from_state.ball)
      Putt.Hud.frame(m.rs, m.aim, p.from_state, vp, at, HudRolling)
    end
    end
  end

  fn moment(m : PuttModel) : HudMoment do
    match m.drag do
    None -> HudWaiting
    Some(d) -> HudPulling(Arcade.Vec2.sub(d.now, d.pressed))
    end
  end

  -- ---- Effects ----
  fn effect(e : PuttFx) : () do
    match e do
    PfAudio(cmds) -> PuttAudio.route(cmds)
    end
  end

  fn perform(effects : List(PuttFx)) : () do
    List.each(effects, effect)
  end

  -- ---- The pointer ----
  fn track_point(p : (Float, Float, Float)) : TrackPoint do
    let (t, x, y) = p
    Arcade.Physics.Gesture.point(t, x, y)
  end

  fn track(raw : List((Float, Float, Float))) : List(TrackPoint) do
    List.map(raw, track_point)
  end

  -- ---- Marks ----
  fn phase_name(p : PuttPhase) : String do
    match p do
    PuttAiming -> "aiming"
    PuttHoleDone -> "hole-done"
    PuttCourseDone -> "course-done"
    end
  end

  fn num(x : Float) : String do
    Arcade.Draw.css_number(x)
  end

  fn place(p : Vec2) : String do
    num(p.x) ++ "," ++ num(p.y)
  end

  -- The pull being held as the frame shows it: the putt's power in m/s, the
  -- metres its first leg covers and whether that leg ends in the cup. Empty
  -- with no pull, or one inside the dead zone.
  fn aim_marks(m : PuttModel) : List((String, String)) do
    let held =
      match (m.drag, m.game.phase) do
      (Some(d), PuttAiming) -> Putt.Aim.shot_of_pull(m.rs, m.aim, Arcade.Vec2.sub(d.now, d.pressed))
      (_, _) -> None
      end
    match held do
    None -> [("data-aim-power", ""), ("data-aim-reach", ""), ("data-aim-holes", "")]
    Some(shot) -> do
      let seen =
        Putt.Aim.preview(m.rs, m.aim, Putt.Rules.current(m.game), m.game.ball, shot)
      [
        ("data-aim-power", num(shot.power)),
        ("data-aim-reach", num(seen.reach)),
        ("data-aim-holes", if seen.holes do "1" else "0" end)
      ]
    end
    end
  end

  -- What the playtest reads off <html>: the phase, the hole (1-based) of
  -- how many, the strokes on it, whether a putt is being shown, the putts
  -- struck; the ball and the cup in course metres and the ball on screen;
  -- the card, the total and whether the hole just finished was holed; the
  -- held pull (aim_marks); what the bands say; the middle of the new-game
  -- button and the pull that is a full-power putt, in CSS pixels.
  fn marks(m : PuttModel) : List((String, String)) do
    let rolling =
      match m.shown do
      Some(_) -> "1"
      None -> "0"
      end
    let h = Putt.Rules.current(m.game)
    let vp = Arcade.Camera.viewport(m.view_w, m.view_h)
    let l = Putt.Hud.projection(m.rs, h, vp)
    let result =
      match m.game.phase do
      PuttAiming -> ""
      PuttHoleDone -> if Putt.Hud.holed(m.game) do "holed" else "picked-up" end
      PuttCourseDone -> "course"
      end
    List.append([("data-phase", phase_name(m.game.phase)), ("data-hole", int_to_string(m.game.hole + 1)), ("data-holes", int_to_string(Putt.Course.hole_count())), ("data-strokes", int_to_string(m.game.strokes)), ("data-rolling", rolling), ("data-putts", int_to_string(m.putts)), ("data-ball", place(m.game.ball)), ("data-cup", place(h.cup)), ("data-ball-px", place(Putt.View.px(m.rs, l, m.game.ball))), ("data-px-per-m", num(Putt.View.scale_of(l))), ("data-card", String.join(List.map(m.game.card, int_to_string), ",")), ("data-total", int_to_string(Putt.Rules.total(m.game))), ("data-result", result), ("data-hud", Putt.Hud.hole_line(m.game) ++ " | " ++ Putt.Hud.par_line(m.game) ++ " | " ++ Putt.Hud.stroke_line(m.game) ++ " | " ++ Putt.Hud.score_line(m.game) ++ " | " ++ Putt.Hud.wind_line(m.rs, m.game.wind)), ("data-card-title", Putt.Hud.card_title(m.game)), ("data-new-game", place(Putt.Hud.box_centre(Putt.Hud.new_game_box(vp)))), ("data-pull-full", num(m.aim.full))], aim_marks(m))
  end

  -- ---- Launch ----
  fn hooks() : Arcade.Web.Runtime.WebHooks(Held, PuttMsg, PuttFx) do
    {
      hook_num: Arcade.Numerics.make(),
      hook_boot: fn (w, h, seed) -> boot(w, h, seed),
      hook_update: fn (b, x) -> held(update(unheld(b), x)),
      hook_perform: fn (_dispatch, effects) -> perform(effects),
      hook_tick: fn t -> PmTick(t),
      hook_resize: fn (w, h) -> PmResize(w, h),
      hook_down: fn raw -> Some(PmDown(track(raw))),
      hook_move: fn raw -> Some(PmMove(track(raw))),
      hook_up: fn raw -> Some(PmUp(track(raw))),
      hook_cancel: Some(PmCancel),
      hook_listen: fn (_model, _dispatch) -> (),
      hook_visible: fn shown -> PmVisible(shown),
      hook_scene: fn b -> scene(unheld(b)),
      hook_overlay: fn _ -> [],
      hook_settle: fn _ -> (),
      hook_marks: fn b -> marks(unheld(b))
    }
  end

  fn main(_f : Cap(IO.Foreign)) : () do
    match Arcade.Web.Runtime.launch("green", fn () -> hooks()) do
    Ok(_) -> ()
    Err(why) -> panic(why)
    end
  end

end
