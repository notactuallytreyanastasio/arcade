mod Putt.Course do

  -- The course: nine one-screen holes, top-down, in metres. Every
  -- hole is a walled rectangle from (0, 0) to (width, length), with +y
  -- running from the tee toward the cup, and may hold wooden blocks (walls
  -- the ball bounces off), sand (slower ground), water (a ball that rolls in
  -- is played again from where it was struck) and slopes (ground that pulls
  -- the ball downhill while it is on them). `gust` multiplies the wind drawn
  -- for the hole: 1.0 on most.
  cap pure

  import Arcade.Vec2

  -- An axis-aligned rectangle, lower-left and upper-right corners.
  type PuttBox = { lo : Vec2, hi : Vec2 }

  -- Sloping ground: inside `area` the ball is pulled by `pull`, in m/s^2,
  -- pointing downhill.
  type PuttSlope = { area : PuttBox, pull : Vec2 }

  type PuttHole = {
    title : String,
    par : Int,
    width : Float,
    length : Float,
    tee : Vec2,
    cup : Vec2,
    blocks : List(PuttBox),
    sands : List(PuttBox),
    waters : List(PuttBox),
    slopes : List(PuttSlope),
    gust : Float
  }

  fn box(x0 : Float, y0 : Float, x1 : Float, y1 : Float) : PuttBox needs () do
    { lo: vec2(x0, y0), hi: vec2(x1, y1) }
  end

  doc """Whether p is inside b, edges included."""
  fn inside(b : PuttBox, p : Vec2) : Bool needs () do
    p.x >= b.lo.x && p.x <= b.hi.x && p.y >= b.lo.y && p.y <= b.hi.y
  end

  doc """Whether p is inside any of the boxes."""
  fn inside_any(bs : List(PuttBox), p : Vec2) : Bool needs () do
    match bs do
    Nil -> false
    Cons(b, rest) -> if inside(b, p) do true else inside_any(rest, p) end
    end
  end

  doc """A slope over the box (x0, y0)-(x1, y1) pulling by (px, py) m/s^2."""
  fn slope(x0 : Float, y0 : Float, x1 : Float, y1 : Float, px : Float, py : Float) : PuttSlope needs () do
    { area: box(x0, y0, x1, y1), pull: vec2(px, py) }
  end

  doc """The pull of the ground at p: the sum of every slope p is on, zero on the flat."""
  fn pull_at(ss : List(PuttSlope), p : Vec2) : Vec2 needs () do
    match ss do
    Nil -> zero()
    Cons(s, rest) -> do
      if inside(s.area, p) do
        add(s.pull, pull_at(rest, p))
      else
        pull_at(rest, p)
      end
    end
    end
  end

  doc """The four corners of a box, anticlockwise from lower-left."""
  fn corners(b : PuttBox) : List(Vec2) needs () do
    [b.lo, vec2(b.hi.x, b.lo.y), b.hi, vec2(b.lo.x, b.hi.y)]
  end

  doc """The hole's outline as a box."""
  fn bounds(h : PuttHole) : PuttBox needs () do
    box(0.0, 0.0, h.width, h.length)
  end

  -- 1. A straight run to warm up.
  fn straight() : PuttHole needs () do
    {
      title: "Straight",
      par: 2,
      width: 1.6,
      length: 6.0,
      tee: vec2(0.8, 0.6),
      cup: vec2(0.8, 5.2),
      blocks: [],
      sands: [],
      waters: [],
      slopes: [],
      gust: 1.0
    }
  end

  -- 2. Sand from the right wall across the line to the cup, with a lane of
  -- green down the left: through the sand hard, round it in two, or off the
  -- left wall.
  fn bunker() : PuttHole needs () do
    {
      title: "Bunker",
      par: 3,
      width: 2.4,
      length: 6.5,
      tee: vec2(1.2, 0.6),
      cup: vec2(1.2, 5.6),
      blocks: [],
      sands: [box(0.6, 2.6, 2.4, 4.2)],
      waters: [],
      slopes: [],
      gust: 1.0
    }
  end

  -- 3. A block across the middle with half a metre either side: the line
  -- off a side wall passes through the gap as it bounces.
  fn bank() : PuttHole needs () do
    {
      title: "Bank",
      par: 3,
      width: 3.0,
      length: 6.0,
      tee: vec2(1.5, 0.6),
      cup: vec2(1.5, 5.2),
      blocks: [box(0.5, 2.7, 2.5, 3.1)],
      sands: [],
      waters: [],
      slopes: [],
      gust: 1.0
    }
  end

  -- 4. A dogleg right then up, the cup out of sight of the tee. Sand in the
  -- outside corner takes the lay-up that is hit too hard.
  fn dogleg() : PuttHole needs () do
    {
      title: "Dogleg",
      par: 3,
      width: 4.0,
      length: 5.0,
      tee: vec2(0.6, 0.8),
      cup: vec2(3.2, 4.3),
      blocks: [box(0.0, 1.6, 2.4, 5.0)],
      sands: [box(3.4, 0.0, 4.0, 1.4)],
      waters: [],
      slopes: [],
      gust: 1.0
    }
  end

  -- 5. Water on the line to the cup. The wide way round, on the left, is
  -- sand; the narrow way, on the right, is clean.
  fn pond() : PuttHole needs () do
    {
      title: "Pond",
      par: 3,
      width: 3.2,
      length: 6.5,
      tee: vec2(1.6, 0.6),
      cup: vec2(1.6, 5.7),
      blocks: [],
      sands: [box(0.0, 2.6, 0.9, 3.8)],
      waters: [box(0.9, 2.4, 2.6, 4.0)],
      slopes: [],
      gust: 1.0
    }
  end

  -- 6. Two walls, the first open on the left, the second on the right, and
  -- sand on the diagonal between the gaps.
  fn chicane() : PuttHole needs () do
    {
      title: "Chicane",
      par: 3,
      width: 3.0,
      length: 6.5,
      tee: vec2(1.5, 0.6),
      cup: vec2(1.5, 5.6),
      blocks: [box(0.6, 2.0, 3.0, 2.3), box(0.0, 4.0, 2.4, 4.3)],
      sands: [box(1.0, 2.8, 2.0, 3.5)],
      waters: [],
      slopes: [],
      gust: 1.0
    }
  end

  -- 7. The top half slopes to the right, toward water, and the cup is on
  -- the slope: every putt at it breaks.
  fn sidehill() : PuttHole needs () do
    {
      title: "Sidehill",
      par: 3,
      width: 3.2,
      length: 6.5,
      tee: vec2(1.4, 0.6),
      cup: vec2(1.3, 5.5),
      blocks: [],
      sands: [],
      waters: [box(2.6, 3.6, 3.2, 6.0)],
      slopes: [slope(0.0, 3.0, 3.2, 6.5, 0.3, 0.0)],
      gust: 1.0
    }
  end

  -- 8. A causeway 0.6 m wide between two ponds, a third behind the cup, and
  -- three times the wind.
  fn causeway() : PuttHole needs () do
    {
      title: "Causeway",
      par: 3,
      width: 3.6,
      length: 7.2,
      tee: vec2(1.8, 0.6),
      cup: vec2(1.8, 6.0),
      blocks: [],
      sands: [],
      waters: [
        box(0.0, 2.6, 1.5, 5.0),
        box(2.1, 2.6, 3.6, 5.0),
        box(1.0, 6.6, 2.6, 7.2)
      ],
      slopes: [],
      gust: 3.0
    }
  end

  -- 9. Everything. Two walls make three legs: right past the first, where
  -- water waits for a ball still heading right; back left across the sand
  -- line; then right again along a slope that runs up to water, the cup on
  -- it.
  fn home() : PuttHole needs () do
    {
      title: "Home",
      par: 4,
      width: 4.2,
      length: 7.2,
      tee: vec2(0.7, 0.6),
      cup: vec2(3.4, 6.0),
      blocks: [box(0.0, 2.4, 2.9, 2.7), box(1.3, 4.6, 4.2, 4.9)],
      sands: [box(1.3, 3.3, 2.3, 4.0)],
      waters: [box(3.3, 3.2, 4.2, 4.6), box(2.0, 6.7, 4.2, 7.2)],
      slopes: [slope(1.6, 4.9, 4.2, 6.7, 0.0, 0.25)],
      gust: 1.0
    }
  end

  doc """The course, first hole first."""
  fn holes() : List(PuttHole) needs () do
    [
      straight(),
      bunker(),
      bank(),
      dogleg(),
      pond(),
      chicane(),
      sidehill(),
      causeway(),
      home()
    ]
  end

  doc """How many holes the course has."""
  fn hole_count() : Int needs () do
    List.length(holes())
  end

  doc """Hole i (0-based), or None past the last."""
  fn hole_at(i : Int) : Option(PuttHole) needs () do
    if i < 0 do None else List.nth_opt(holes(), i) end
  end

  doc """The largest `gust` on the course: how far past wind_max a hole's wind can be."""
  fn max_gust() : Float needs () do
    List.fold_left(holes(), 1.0, fn (acc, h) -> Arcade.Num.max_float(acc, h.gust))
  end

  doc """The par of the whole course."""
  fn course_par() : Int needs () do
    List.fold_left(holes(), 0, fn (acc, h) -> acc + h.par)
  end

end
